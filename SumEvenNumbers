package array_based_problems;

import java.util.Scanner;

public class SumEvenNumbers {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int sum = 0;
		int arr[] = new int[n];
		for(int i = 0;i < n;i++) {
			arr[i] = sc.nextInt();
		}
		for(int i = 0;i < n;i++) {
			if(arr[i] % 2 == 0) {
				sum += arr[i];
				//System.out.println(sum);
			}
			//System.out.println(sum);
		}
		System.out.println(sum);

	}

}
